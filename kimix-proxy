#!/usr/bin/env python3
"""
kimix-proxy  —  Translates OpenAI Responses API ↔ Kimi Chat Completions.

Upstream Codex talks Responses API; Kimi only speaks Chat Completions.
This proxy sits in between so you can run the stock Codex binary unpatched.

Install deps:  pip3 install flask requests
Run:           kimix-proxy [--port 8787]

Then point your kimix CODEX_HOME config at it:
  [model_providers.kimi]
  base_url = "http://127.0.0.1:8787/v1"
  env_key  = "KIMIX_API_KEY"
  wire_api = "responses"
"""

import argparse
import json
import sys
import time
import uuid
import os

try:
    import flask
    import requests as req_lib
except ImportError:
    sys.exit(
        "kimix-proxy requires flask and requests.\n"
        "Install with:  pip3 install flask requests"
    )

from flask import Flask, request, Response

KIMI_BASE = os.environ.get("KIMIX_BASE_URL", "https://api.kimi.com/coding/v1")

app = Flask(__name__)

# ---------------------------------------------------------------------------
# Request conversion: Responses API → Chat Completions
# ---------------------------------------------------------------------------

def _extract_text(content):
    """Flatten a content array or string to a plain string."""
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for c in content:
            if isinstance(c, dict):
                parts.append(c.get("text") or c.get("content") or "")
            else:
                parts.append(str(c))
        return "".join(parts)
    return str(content)


def _convert_tools(tools):
    """Convert Responses API tool defs to Chat Completions format."""
    if not tools:
        return []
    out = []
    for t in tools:
        if not isinstance(t, dict):
            continue
        kind = t.get("type", "")
        if kind == "local_shell":
            # local_shell has no CC equivalent; skip — stock Codex with custom
            # providers already registers a function-based shell tool instead.
            pass
        elif kind == "function":
            if "function" in t:
                # Already Chat Completions format
                out.append(t)
            else:
                # Responses API format: name at top level
                fn = {
                    "name": t.get("name", ""),
                    "description": t.get("description", ""),
                }
                if "parameters" in t:
                    fn["parameters"] = t["parameters"]
                if "strict" in t:
                    fn["strict"] = t["strict"]
                out.append({"type": "function", "function": fn})
        # Skip web_search_preview and other Responses-only types
    return out


def _items_to_messages(instructions, input_items):
    """Convert Responses API input[] + instructions to Chat Completions messages."""
    messages = []
    if instructions:
        messages.append({"role": "system", "content": instructions})

    pending_tool_calls = []  # accumulate function_call items for one assistant turn

    def flush_tool_calls():
        if pending_tool_calls:
            messages.append({
                "role": "assistant",
                "content": None,
                "tool_calls": list(pending_tool_calls),
            })
            pending_tool_calls.clear()

    for item in input_items:
        if not isinstance(item, dict):
            continue
        kind = item.get("type", "")

        if kind == "message":
            flush_tool_calls()
            role = item.get("role", "user")
            # Map Responses-only roles to Chat Completions equivalents
            if role == "developer":
                role = "system"
            content = _extract_text(item.get("content", ""))
            messages.append({"role": role, "content": content})

        elif kind == "function_call":
            # Multiple function_calls belong to the same assistant turn
            tc = {
                "id": item.get("call_id") or item.get("id") or f"call_{uuid.uuid4().hex[:8]}",
                "type": "function",
                "function": {
                    "name": item.get("name", ""),
                    "arguments": item.get("arguments", ""),
                },
            }
            pending_tool_calls.append(tc)

        elif kind == "function_call_output":
            flush_tool_calls()
            output = item.get("output", {})
            if isinstance(output, dict):
                content_items = output.get("content_items")
                if content_items:
                    content = _extract_text(content_items)
                else:
                    content = output.get("content", json.dumps(output))
            else:
                content = str(output)
            messages.append({
                "role": "tool",
                "tool_call_id": item.get("call_id", ""),
                "content": content,
            })

        elif kind in ("local_shell_call",):
            # Convert local_shell_call to a function_call equivalent
            action = item.get("action") or {}
            arguments = json.dumps(action) if action else "{}"
            tc = {
                "id": item.get("call_id") or item.get("id") or f"call_{uuid.uuid4().hex[:8]}",
                "type": "function",
                "function": {"name": "shell", "arguments": arguments},
            }
            pending_tool_calls.append(tc)

        # Skip: reasoning, compaction, other, web_search_call, ghost_snapshot,
        # custom_tool_call, custom_tool_call_output
    flush_tool_calls()
    return messages


def _map_effort(reasoning):
    """Map Responses API reasoning.effort → Kimi reasoning_effort string."""
    if not reasoning:
        return None
    effort = reasoning.get("effort")
    if effort in ("low", "high", "max"):
        return effort
    if effort == "medium":
        return "high"
    if effort in ("minimal", "none") or not effort:
        return None
    return None


def build_chat_request(body):
    model        = body.get("model", "k3")
    instructions = body.get("instructions", "")
    input_items  = body.get("input", [])
    tools_raw    = body.get("tools") or []
    reasoning    = body.get("reasoning")

    messages = _items_to_messages(instructions, input_items)
    tools    = _convert_tools(tools_raw)
    effort   = _map_effort(reasoning)

    payload = {
        "model": model,
        "messages": messages,
        "stream": True,
        "stream_options": {"include_usage": True},
    }
    if tools:
        payload["tools"] = tools
        payload["tool_choice"] = body.get("tool_choice", "auto")
    if effort:
        payload["reasoning_effort"] = effort

    return payload


# ---------------------------------------------------------------------------
# Response conversion: Chat Completions SSE → Responses API SSE
# ---------------------------------------------------------------------------

def _sse_event(event_type, data):
    return f"event: {event_type}\ndata: {json.dumps(data)}\n\n"


def convert_stream(chat_stream, resp_id):
    """Generator: yields Responses API SSE lines from a Chat Completions stream."""
    item_id      = f"item_{uuid.uuid4().hex[:12]}"
    reason_id    = f"rs_{uuid.uuid4().hex[:12]}"
    _next_idx    = 0   # next output index to assign

    # Accumulated state
    text_buf        = ""
    reason_buf      = ""
    tool_calls      = {}   # index → {id, name, arguments}
    tc_order        = []   # insertion-ordered indices
    created_sent    = False
    item_added      = False
    reasoning_added = False
    reason_out_idx  = None
    text_out_idx    = None
    usage           = None  # from stream_options.include_usage

    def ensure_created():
        nonlocal created_sent
        if not created_sent:
            created_sent = True
            yield _sse_event("response.created", {
                "type": "response.created",
                "response": {
                    "id": resp_id,
                    "object": "realtime.response",
                    "status": "in_progress",
                },
            })

    def ensure_item_added():
        nonlocal item_added, text_out_idx, _next_idx
        if not item_added:
            text_out_idx = _next_idx
            _next_idx += 1
            item_added = True
            yield _sse_event("response.output_item.added", {
                "type": "response.output_item.added",
                "output_index": text_out_idx,
                "item": {
                    "id": item_id,
                    "object": "realtime.item",
                    "type": "message",
                    "status": "in_progress",
                    "role": "assistant",
                    "content": [],
                },
            })

    def ensure_reasoning_added():
        nonlocal reasoning_added, reason_out_idx, _next_idx
        if not reasoning_added:
            reason_out_idx = _next_idx
            _next_idx += 1
            reasoning_added = True
            yield _sse_event("response.output_item.added", {
                "type": "response.output_item.added",
                "output_index": reason_out_idx,
                "item": {
                    "id": reason_id,
                    "type": "reasoning",
                    "summary": [],
                    "content": [],
                    "status": "in_progress",
                },
            })

    def close_open_items(finish):
        """Emit done events for any open reasoning/text items."""
        if reasoning_added:
            yield _sse_event("response.output_item.done", {
                "type": "response.output_item.done",
                "output_index": reason_out_idx,
                "item": {
                    "id": reason_id,
                    "type": "reasoning",
                    "summary": [],
                    "content": [],
                    "status": "completed",
                },
            })
        if item_added or text_buf:
            yield _sse_event("response.output_item.done", {
                "type": "response.output_item.done",
                "output_index": text_out_idx if text_out_idx is not None else _next_idx,
                "item": {
                    "id": item_id,
                    "type": "message",
                    "status": "completed",
                    "role": "assistant",
                    "content": [{"type": "output_text", "text": text_buf}],
                },
            })

    try:
        for line in chat_stream.iter_lines(chunk_size=1, decode_unicode=True):
            if not line:
                continue
            if line in ("data: [DONE]", "data:[DONE]"):
                break

            # SSE data lines: "data: ..." or "data:{...}" (both are valid SSE)
            if line.startswith("data:"):
                raw = line[5:].lstrip()
            else:
                continue

            try:
                chunk = json.loads(raw)
            except json.JSONDecodeError:
                continue

            # Capture usage if present (stream_options.include_usage)
            if chunk.get("usage"):
                usage = chunk["usage"]

            # Error chunk from Kimi
            if chunk.get("error"):
                yield from ensure_created()
                yield _sse_event("response.failed", {
                    "type": "response.failed",
                    "response": {
                        "id": resp_id,
                        "status": "failed",
                        "error": chunk["error"],
                    },
                })
                return

            choices = chunk.get("choices") or []
            for choice in choices:
                delta  = choice.get("delta") or {}
                finish = choice.get("finish_reason")

                # --- reasoning delta ---
                reasoning_text = delta.get("reasoning") or delta.get("reasoning_content")
                if reasoning_text:
                    if isinstance(reasoning_text, dict):
                        reasoning_text = (
                            reasoning_text.get("text") or
                            reasoning_text.get("content") or ""
                        )
                    if reasoning_text:
                        yield from ensure_created()
                        yield from ensure_reasoning_added()
                        reason_buf += reasoning_text
                        yield _sse_event("response.reasoning_text.delta", {
                            "type": "response.reasoning_text.delta",
                            "output_index": reason_out_idx,
                            "content_index": 0,
                            "item_id": reason_id,
                            "delta": reasoning_text,
                        })

                # --- text delta ---
                content = delta.get("content")
                if content and isinstance(content, str):
                    yield from ensure_created()
                    yield from ensure_item_added()
                    text_buf += content
                    yield _sse_event("response.output_text.delta", {
                        "type": "response.output_text.delta",
                        "output_index": text_out_idx,
                        "content_index": 0,
                        "delta": content,
                    })

                # --- tool call deltas ---
                tc_deltas = delta.get("tool_calls") or []
                for tc in tc_deltas:
                    yield from ensure_created()
                    idx = tc.get("index", 0)
                    if idx not in tool_calls:
                        tool_calls[idx] = {"id": "", "name": "", "arguments": ""}
                        tc_order.append(idx)
                    state = tool_calls[idx]
                    if tc.get("id"):
                        state["id"] = state["id"] or tc["id"]
                    fn = tc.get("function") or {}
                    if fn.get("name"):
                        state["name"] = state["name"] or fn["name"]
                    if fn.get("arguments"):
                        state["arguments"] += fn["arguments"]

                # --- finish ---
                if finish in ("stop", "length") or (
                    finish and finish not in ("tool_calls",)
                ):
                    yield from ensure_created()
                    yield from close_open_items(finish)

                elif finish == "tool_calls":
                    yield from ensure_created()
                    yield from close_open_items(finish)
                    for idx in tc_order:
                        state = tool_calls[idx]
                        tc_item_id = f"fc_{uuid.uuid4().hex[:12]}"
                        call_id = state["id"] or f"call_{uuid.uuid4().hex[:8]}"
                        tc_out_idx = _next_idx
                        _next_idx += 1
                        yield _sse_event("response.output_item.added", {
                            "type": "response.output_item.added",
                            "output_index": tc_out_idx,
                            "item": {
                                "id": tc_item_id,
                                "type": "function_call",
                                "call_id": call_id,
                                "name": state["name"],
                                "arguments": "",
                                "status": "in_progress",
                            },
                        })
                        yield _sse_event("response.output_item.done", {
                            "type": "response.output_item.done",
                            "output_index": tc_out_idx,
                            "item": {
                                "id": tc_item_id,
                                "type": "function_call",
                                "call_id": call_id,
                                "name": state["name"],
                                "arguments": state["arguments"],
                                "status": "completed",
                            },
                        })
                    tc_order.clear()
                    tool_calls.clear()

    except Exception as exc:
        yield from ensure_created()
        yield _sse_event("response.failed", {
            "type": "response.failed",
            "response": {
                "id": resp_id,
                "status": "failed",
                "error": {"message": str(exc), "type": "stream_error"},
            },
        })
        return

    # Build usage from Kimi's token counts. Crucially, surface Kimi's
    # automatic prefix-cache hits so Codex reports (and credits) them:
    # Codex reads usage.input_tokens_details.cached_tokens from the
    # response.completed event. Kimi reports cached tokens both at the top
    # level (usage.cached_tokens) and under prompt_tokens_details.
    if usage:
        prompt_details = usage.get("prompt_tokens_details") or {}
        completion_details = usage.get("completion_tokens_details") or {}
        cached = (
            prompt_details.get("cached_tokens")
            if prompt_details.get("cached_tokens") is not None
            else usage.get("cached_tokens", 0)
        ) or 0
        reasoning = completion_details.get("reasoning_tokens", 0) or 0
        token_usage = {
            "input_tokens":  usage.get("prompt_tokens", 0),
            "input_tokens_details": {"cached_tokens": cached},
            "output_tokens": usage.get("completion_tokens", 0),
            "output_tokens_details": {"reasoning_tokens": reasoning},
            "total_tokens":  usage.get("total_tokens", 0),
        }
    else:
        token_usage = {
            "input_tokens": 0,
            "input_tokens_details": {"cached_tokens": 0},
            "output_tokens": 0,
            "output_tokens_details": {"reasoning_tokens": 0},
            "total_tokens": 0,
        }

    yield from ensure_created()
    yield _sse_event("response.completed", {
        "type": "response.completed",
        "response": {
            "id": resp_id,
            "object": "realtime.response",
            "status": "completed",
            "output": [],
            "usage": token_usage,
        },
    })


# ---------------------------------------------------------------------------
# Flask routes
# ---------------------------------------------------------------------------

def _get_auth():
    auth = request.headers.get("Authorization", "")
    if not auth:
        key = os.environ.get("KIMIX_API_KEY", "")
        auth = f"Bearer {key}" if key else ""
    return auth


@app.route("/v1/responses", methods=["POST"])
def responses():
    body = request.get_json(force=True, silent=True) or {}
    auth = _get_auth()

    try:
        chat_body = build_chat_request(body)
    except Exception as exc:
        return {"error": str(exc)}, 400

    resp_id = f"resp_{uuid.uuid4().hex[:16]}"
    url = f"{KIMI_BASE.rstrip('/')}/chat/completions"
    headers = {
        "Authorization": auth,
        "Content-Type": "application/json",
        "Accept": "text/event-stream",
    }

    # Kimi's coding API rate-limits by tokens/min and concurrency. Agentic
    # clients (codex exec) fire large uncached requests back-to-back, so a 429
    # burst is normal operation, not failure: absorb it here with bounded
    # backoff honoring Retry-After, instead of letting the client's short
    # retry budget turn a throttle into a dead run.
    retryable = {429, 500, 502, 503, 504}
    max_attempts = int(os.environ.get("KIMIX_UPSTREAM_RETRIES", "5"))
    upstream = None
    for attempt in range(1, max_attempts + 1):
        try:
            upstream = req_lib.post(url, json=chat_body, headers=headers,
                                    stream=True, timeout=300)
        except Exception as exc:
            return {"error": {"message": str(exc), "type": "connection_error"}}, 502
        if upstream.status_code not in retryable or attempt == max_attempts:
            break
        retry_after = upstream.headers.get("Retry-After")
        try:
            delay = min(float(retry_after), 60.0) if retry_after else 0.0
        except ValueError:
            delay = 0.0
        if delay <= 0.0:
            delay = min(2.0 ** attempt, 30.0)
        upstream.close()
        print(f"kimix-proxy: upstream {upstream.status_code}, "
              f"retry {attempt}/{max_attempts - 1} in {delay:.1f}s",
              file=sys.stderr, flush=True)
        time.sleep(delay)

    if not upstream.ok:
        resp = Response(upstream.text, status=upstream.status_code,
                        content_type="application/json")
        retry_after = upstream.headers.get("Retry-After")
        if retry_after:
            resp.headers["Retry-After"] = retry_after
        return resp

    def generate():
        yield from convert_stream(upstream, resp_id)

    return Response(generate(), content_type="text/event-stream")


@app.route("/v1/models", methods=["GET"])
def models():
    """Transparent proxy to Kimi's models endpoint."""
    auth = _get_auth()
    url = f"{KIMI_BASE.rstrip('/')}/models"
    try:
        r = req_lib.get(url, headers={"Authorization": auth}, timeout=30)
        return Response(r.content, status=r.status_code,
                        content_type=r.headers.get("Content-Type", "application/json"))
    except Exception as exc:
        return {"error": str(exc)}, 502


@app.route("/health", methods=["GET"])
def health():
    return {"status": "ok", "upstream": KIMI_BASE}


@app.errorhandler(404)
def not_found(_):
    return {"error": "kimix-proxy: unknown endpoint"}, 404


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="kimix-proxy: Responses API → Kimi Chat Completions"
    )
    parser.add_argument("--port", type=int, default=8787,
                        help="Port to listen on (default: 8787)")
    parser.add_argument("--host", default="127.0.0.1",
                        help="Host to bind (default: 127.0.0.1)")
    args = parser.parse_args()

    print(f"kimix-proxy listening on http://{args.host}:{args.port}/v1", flush=True)
    print(f"  → forwarding to {KIMI_BASE}", flush=True)
    app.run(host=args.host, port=args.port, threaded=True)


if __name__ == "__main__":
    main()
