#!/usr/bin/env bash
# kimix — launch Codex directly against Kimi's native Responses API.
# API key: $KIMI_API_KEY (the documented name); $KIMIX_API_KEY remains a
# backwards-compatible alias. Model: $KIMIX_MODEL (default: kimi-k3).
set -euo pipefail

TOKEN_FILE="${KIMIX_TOKEN_FILE:-$HOME/.kimix/token}"

# Kimi's Codex integration expects KIMI_API_KEY. Accept the older wrapper
# variable and token-file setup so upgrading kimix does not require users to
# rotate or re-save their API keys.
if [[ -n "${KIMI_API_KEY:-}" ]]; then
  : # documented variable already set
elif [[ -n "${KIMIX_API_KEY:-}" ]]; then
  KIMI_API_KEY="$KIMIX_API_KEY"
elif [[ -f "$TOKEN_FILE" ]]; then
  KIMI_API_KEY="$(< "$TOKEN_FILE")"
else
  echo "kimix: KIMI_API_KEY is not set and $TOKEN_FILE was not found." >&2
  echo "       Set KIMI_API_KEY (recommended), or KIMIX_API_KEY for compatibility." >&2
  exit 1
fi
export KIMI_API_KEY

# Kimi's native Codex integration is the 1M-context kimi-k3 model. A caller
# that deliberately selects a different model can supply its own window and
# compaction limits through the KIMIX_* overrides below.
KIMIX_MODEL="${KIMIX_MODEL:-kimi-k3}"
KIMIX_CONTEXT_WINDOW="${KIMIX_MODEL_CONTEXT_WINDOW:-1048576}"
KIMIX_AUTO_COMPACT_LIMIT="${KIMIX_AUTO_COMPACT_TOKEN_LIMIT:-943718}"

# Keep Kimi configuration isolated from the user's normal Codex profile. The
# previous proxy-backed path used ~/.kimix/codex-proxy; a new directory avoids
# accidentally retaining its localhost endpoint after an upgrade.
export CODEX_HOME="${KIMIX_CODEX_HOME:-$HOME/.kimix/codex}"
mkdir -p "$CODEX_HOME"
CONFIG="$CODEX_HOME/config.toml"

# Optional: cap AGENTS.md/CLAUDE.md bytes injected by Codex for a session.
DOC_CAP_LINE=""
if [[ -n "${KIMIX_PROJECT_DOC_MAX_BYTES:-}" ]]; then
  DOC_CAP_LINE="project_doc_max_bytes = ${KIMIX_PROJECT_DOC_MAX_BYTES}"
fi

# Kimi natively implements the Responses API used by Codex. Using it directly
# preserves the complete event protocol, including compaction and tool-call
# continuation, instead of translating it through a local Chat Completions
# proxy. Regenerate this derived config on every invocation so upgrades take
# effect immediately.
cat > "$CONFIG" <<TOML
model = "${KIMIX_MODEL}"
model_provider = "kimi"
model_reasoning_effort = "high"
approval_policy = "never"
sandbox_mode = "danger-full-access"
suppress_unstable_features_warning = true
model_context_window = ${KIMIX_CONTEXT_WINDOW}
model_auto_compact_token_limit = ${KIMIX_AUTO_COMPACT_LIMIT}
${DOC_CAP_LINE}

[model_providers.kimi]
name = "Kimi"
base_url = "https://api.moonshot.ai/v1"
env_key = "KIMI_API_KEY"
wire_api = "responses"

[tools.unified_exec]
default_max_output_tokens = 4000

[projects]
TOML

CODEX_BIN="${KIMIX_CODEX_BIN:-$(command -v codex 2>/dev/null || echo "$HOME/.local/bin/codex")}"

# Explicit user model flags take precedence. Codex rejects repeated --model
# flags, so only provide our default when the caller has not selected one.
USER_MODEL=0
for arg in "$@"; do
  case "$arg" in
    -m|--model|-m?*|--model=*) USER_MODEL=1; break ;;
  esac
done

# A non-terminal stdin is normally an inherited descriptor in automation, not
# prompt text. Point it at /dev/null so Codex does not wait indefinitely for
# additional input. Set KIMIX_STDIN=1 to intentionally pipe a prompt.
AUTOMATION=0
if [[ -z "${KIMIX_STDIN:-}" && ! -t 0 ]]; then
  exec 0</dev/null
  AUTOMATION=1
fi

CODEX_ARGS=(
  -c "model_context_window=${KIMIX_CONTEXT_WINDOW}"
  -c "model_auto_compact_token_limit=${KIMIX_AUTO_COMPACT_LIMIT}"
)
if (( USER_MODEL )); then
  CODEX_ARGS=("$CODEX_BIN" "${CODEX_ARGS[@]}" "$@")
else
  CODEX_ARGS=("$CODEX_BIN" -m "$KIMIX_MODEL" "${CODEX_ARGS[@]}" "$@")
fi

# Preserve interactive terminal ownership. In automation, inspect Codex's
# combined output because some Codex versions have reported context exhaustion
# while still returning exit status 0.
if (( ! AUTOMATION )); then
  exec "${CODEX_ARGS[@]}"
fi

OUTPUT_FILE="$(mktemp)"
trap 'rm -f "$OUTPUT_FILE"' EXIT
set +e
"${CODEX_ARGS[@]}" 2>&1 | tee "$OUTPUT_FILE"
CODEX_EXIT="${PIPESTATUS[0]}"
set -e

if rg -qi 'ran out of room|context window|context_length_exceeded|maximum context length' "$OUTPUT_FILE"; then
  echo "kimix: codex reported a context-window failure but may have exited 0 — treating this run as failed." >&2
  exit 1
fi
exit "$CODEX_EXIT"
