#!/usr/bin/env bash
# glm — launch Claude Code against the Z.ai GLM Coding Plan (Anthropic-compatible API).
# Token: $ZAI_CODING_PLAN_API_KEY (set in ~/.zshrc)
set -euo pipefail

if [[ -z "${ZAI_CODING_PLAN_API_KEY:-}" ]]; then
  echo "glm: ZAI_CODING_PLAN_API_KEY is not set (expected in ~/.zshrc)." >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
export ANTHROPIC_AUTH_TOKEN="$ZAI_CODING_PLAN_API_KEY"
export ANTHROPIC_MODEL="${GLM_MODEL:-glm-4.6}"
export ANTHROPIC_SMALL_FAST_MODEL="${GLM_FAST_MODEL:-glm-4.5-air}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ANTHROPIC_SMALL_FAST_MODEL"
# Avoid a stray real Anthropic key hijacking the routed endpoint.
unset ANTHROPIC_API_KEY

exec claude "$@"
