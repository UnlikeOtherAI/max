{
  "name": "minimax-claude-cli",
  "version": "1.1.0",
  "description": "CLI wrappers for Claude Code and Codex, including active Strata model selection",
  "bin": {
    "max": "./max",
    "maxis": "./maxis"
  },
  "scripts": {
    "postinstall": "node -e \"for (const name of ['max','maxis']) require('node:fs').chmodSync(name, 0o755)\"",
    "test:maxis": "node --test tests/maxis.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UnlikeOtherAI/max"
  },
  "keywords": [
    "claude",
    "claude-code",
    "minimax",
    "cli"
  ],
  "author": "Unlike Other AI",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "max",
    "glm",
    "klaude",
    "kimix",
    "maxis",
    "install-maxis.cjs",
    "README.md",
    "LICENSE"
  ]
}
